# hostmon-light — English example configuration
# One active .env per host; no separate .env.build.
# Build/push uses IMAGE_REPOSITORY, IMAGE_TAG, GO_VERSION.
# Runtime additionally needs host settings, mount source and token file.
# Do not put tokens or registry credentials here.
# Do not commit local .env or secrets/.
# HTTP without TLS: use protected transport; configure firewall separately.
# Resource evaluation and notifications are external to the agent.

# Repository without tag; replace the placeholder with your own registry.
IMAGE_REPOSITORY=registry.example.com/home/hostmon-light

# Version for build, push and runtime. Do not overwrite published release tags.
IMAGE_TAG=0.1.0

# Required only for the builder; change deliberately and retest.
GO_VERSION=1.26.10

# Container UID; UID 0 is rejected.
HOSTMON_UID=65532

# Container GID; align token read permissions with it.
HOSTMON_GID=65532

# Required for runtime: local LAN IP of the monitored host, not the monitoring host. Host networking; configure the firewall separately.
HOST_LAN_IP=

# API port on the specified LAN IP.
MONITOR_PORT=9109

# Required for runtime: host identifier in JSON responses.
MONITOR_HOSTNAME=

# Positive Go duration, at least 1s.
MONITOR_SAMPLE_INTERVAL=10s

# Maximum snapshot age; at least twice the sampling interval. Stale API data returns HTTP 503.
MONITOR_MAX_SAMPLE_AGE=30s

# Existing empty directory on the filesystem to measure; check using findmnt -T. Do not blindly mount /. Not needed on a build-only host.
MONITOR_DISK_ROOT_SOURCE=/mnt/hostmon-light-root

# name=container_path; separate entries with commas. Additional sources require additional read-only bind mounts in compose.yaml. Measures filesystem usage, not directory size.
MONITOR_FILESYSTEMS=root=/host/disks/root

# Host path, relative to the Compose project or absolute. File contains only the token, no Bearer prefix; at least 32 bytes. Generate using openssl rand -hex 32. Local user owns the file; match its group to the container GID and use mode 0640.
MONITOR_TOKEN_HOST_FILE=./secrets/api_token

# Positive Go duration for reading HTTP headers.
MONITOR_HTTP_READ_HEADER_TIMEOUT=5s

# Positive Go duration for HTTP responses.
MONITOR_HTTP_WRITE_TIMEOUT=5s

# Positive Go duration for idle HTTP connections.
MONITOR_HTTP_IDLE_TIMEOUT=30s

# debug | info | warn | error
MONITOR_LOG_LEVEL=info

# json | text
MONITOR_LOG_FORMAT=json

# Docker local logging: maximum size per log file.
DOCKER_LOG_MAX_SIZE=5m

# Maximum file count including the current log file.
DOCKER_LOG_MAX_FILE=3

# Compress rotated Docker logs.
DOCKER_LOG_COMPRESS=true

# Container memory limit, not an alert threshold.
MONITOR_MEMORY_LIMIT=64m

# Container CPU limit, not an alert threshold.
MONITOR_CPU_LIMIT=0.25

# Container process limit.
MONITOR_PIDS_LIMIT=32

# Healthcheck interval; checks snapshot freshness, not resource thresholds or full collector readiness.
MONITOR_HEALTH_INTERVAL=30s

# Docker healthcheck timeout.
MONITOR_HEALTH_TIMEOUT=3s

# Failures before unhealthy. Docker does not automatically restart a container solely because it becomes unhealthy.
MONITOR_HEALTH_RETRIES=3

# Startup grace period; account for longer sampling intervals. CPU requires two samples.
MONITOR_HEALTH_START_PERIOD=20s
