# hostmon-light — deutsche Beispielkonfiguration
# Eine aktive .env pro Host; keine .env.build.
# Build/Push benötigt IMAGE_REPOSITORY, IMAGE_TAG, GO_VERSION.
# Betrieb benötigt zusätzlich Hostwerte, Mountquelle und Token-Datei.
# Keine Tokens oder Registry-Zugangsdaten hier eintragen.
# Lokale .env und secrets/ nicht einchecken.
# HTTP ohne TLS: nur geschützt betreiben; Firewall separat konfigurieren.
# Ressourcenbewertung und Benachrichtigungen erfolgen außerhalb des Agenten.

# Repository ohne Tag; Platzhalter durch eigene Registry ersetzen.
IMAGE_REPOSITORY=registry.example.com/home/hostmon-light

# Version für Build, Push und Betrieb. Veröffentlichte Tags nicht überschreiben.
IMAGE_TAG=0.1.0

# Nur für den Builder benötigt; bewusst ändern und erneut testen.
GO_VERSION=1.26.10

# Container-UID; UID 0 wird verweigert.
HOSTMON_UID=65532

# Container-GID; Token-Leserechte darauf abstimmen.
HOSTMON_GID=65532

# Für Betrieb erforderlich: lokale LAN-IP des überwachten Hosts, nicht des Monitoringhosts. Host-Netzwerk; Firewall separat konfigurieren.
HOST_LAN_IP=

# API-Port an der angegebenen LAN-IP.
MONITOR_PORT=9109

# Für Betrieb erforderlich: Hostkennung in der JSON-Antwort.
MONITOR_HOSTNAME=

# Positive Go-Dauer, mindestens 1s.
MONITOR_SAMPLE_INTERVAL=10s

# Maximales Snapshot-Alter; mindestens zweimal Messintervall. Veraltete API-Daten ergeben HTTP 503.
MONITOR_MAX_SAMPLE_AGE=30s

# Vorhandenes leeres Verzeichnis auf dem zu messenden Dateisystem; mit findmnt -T prüfen. Nicht blind / einbinden. Auf reinem Buildhost nicht benötigt.
MONITOR_DISK_ROOT_SOURCE=/mnt/hostmon-light-root

# name=Containerpfad; mehrere Einträge mit Komma trennen. Weitere Quellen erfordern zusätzliche read-only Bind-Mounts in compose.yaml. Gemessen wird das Dateisystem, nicht die Ordnergröße.
MONITOR_FILESYSTEMS=root=/host/disks/root

# Pfad auf dem Host, relativ zum Compose-Projekt oder absolut. Nur Token in der Datei, kein Bearer-Präfix; mindestens 32 Bytes. Erzeugung: openssl rand -hex 32. Eigentümer lokaler Benutzer, Gruppe passend zur Container-GID, Modus 0640.
MONITOR_TOKEN_HOST_FILE=./secrets/api_token

# Positive Go-Dauer für das Lesen der HTTP-Header.
MONITOR_HTTP_READ_HEADER_TIMEOUT=5s

# Positive Go-Dauer für HTTP-Antworten.
MONITOR_HTTP_WRITE_TIMEOUT=5s

# Positive Go-Dauer für inaktive HTTP-Verbindungen.
MONITOR_HTTP_IDLE_TIMEOUT=30s

# debug | info | warn | error
MONITOR_LOG_LEVEL=info

# json | text
MONITOR_LOG_FORMAT=json

# Docker local-Logging: maximale Größe je Logdatei.
DOCKER_LOG_MAX_SIZE=5m

# Maximale Dateianzahl einschließlich aktueller Logdatei.
DOCKER_LOG_MAX_FILE=3

# Rotierte Docker-Logs komprimieren.
DOCKER_LOG_COMPRESS=true

# Container-Speicherlimit, kein Alarm-Schwellwert.
MONITOR_MEMORY_LIMIT=64m

# Container-CPU-Limit, kein Alarm-Schwellwert.
MONITOR_CPU_LIMIT=0.25

# Container-Prozesslimit.
MONITOR_PIDS_LIMIT=32

# Healthcheck-Abstand; prüft Snapshot-Aktualität, nicht Ressourcen-Schwellwerte oder vollständige Collector-Bereitschaft.
MONITOR_HEALTH_INTERVAL=30s

# Docker-Timeout des Healthchecks.
MONITOR_HEALTH_TIMEOUT=3s

# Fehlversuche bis unhealthy. Docker startet einen nur unhealthy gewordenen Container nicht automatisch neu.
MONITOR_HEALTH_RETRIES=3

# Startphase; bei längeren Messintervallen berücksichtigen. CPU benötigt zwei Messpunkte.
MONITOR_HEALTH_START_PERIOD=20s
